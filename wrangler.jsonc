{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baihe-volleyball-2027",
  "compatibility_date": "2026-08-10",
  // Cloudflare Pages：網址為 baihe-volleyball-2027.pages.dev（不含帳號名稱）
  // 注意：Pages 的設定檔不支援 account_id。
